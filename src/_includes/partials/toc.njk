{% if item and item.toc.length > 0 %}
  <nav class="toc" aria-label="Nesta página">
    <p class="toc__title">Nesta página</p>
    <ul class="toc__list">
      {% for heading in item.toc %}
        <li class="toc__item toc__item--h{{ heading.level }}">
          <a href="#{{ heading.id }}" data-toc-link="{{ heading.id }}">{{ heading.text }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
