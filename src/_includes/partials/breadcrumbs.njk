{% if item and item.breadcrumbs.length > 1 %}
  <nav class="breadcrumbs" aria-label="Trilha de navegação">
    <a href="{{ '/' | link }}">Início</a>
    {% for crumb in item.breadcrumbs %}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      {% if crumb.current %}
        <span class="breadcrumbs__current" aria-current="page">{{ crumb.title }}</span>
      {% else %}
        <a href="{{ crumb.url | link }}">{{ crumb.title }}</a>
      {% endif %}
    {% endfor %}
  </nav>
{% endif %}
