{# Barra lateral: marca, busca (Fase 2) e árvore de navegação por `order`. #}
<aside class="sidebar" id="sidebar">
  <div class="sidebar__head">
    <a class="brand" href="{{ '/' | link }}">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__text">
        <strong>{{ site.title }}</strong>
        <small>{{ site.subtitle }}</small>
      </span>
    </a>
    <button class="icon-btn sidebar__toggle" type="button" data-sidebar-toggle aria-label="Alternar navegação">☰</button>
  </div>

  <nav class="nav" aria-label="Navegação principal">
    {% macro navTree(nodes) %}
      <ul class="nav-tree">
        {% for node in nodes %}
          <li class="nav-item nav-item--{{ node.kind }}">
            {% if node.kind == 'folder' %}
              <a class="nav-link{% if node.url == page.url %} is-active{% endif %}" href="{{ node.url | link }}">{{ node.name }}</a>
              {% if node.children.length > 0 %}{{ navTree(node.children) }}{% endif %}
            {% else %}
              <a class="nav-link{% if node.url == page.url %} is-active{% endif %}" href="{{ node.url | link }}">{{ node.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endmacro %}
    {{ navTree(navigation) }}
  </nav>
</aside>
